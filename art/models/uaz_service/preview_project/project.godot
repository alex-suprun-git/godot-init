config_version=5

[application]
config/name="Service vehicles — asset review"
run/main_scene="res://preview.tscn"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1100
window/size/window_width_override=1280
window/size/window_height_override=880
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.12,0.15,0.16,1)
