# Dev tool: measures where each sprite stands on the ground and writes the result
# to scripts/data/sprite_anchors.gd. Run it whenever sprites are added or redrawn:
#   Godot --headless --path init --script res://scripts/dev/measure_sprite_anchors.gd
#
# For every image in assets/sprites it finds
#   anchor: the point on the ground edge under the middle of the object, as
#           fractions of the image (x from the left, y from the top);
#   slope:  how steeply the ground edge runs across the image (positive: falls to
#           the right, like "\", which is how a prop along the map's X axis looks;
#           negative: like "/", a prop along the Z axis).
# Long props use a line fitted to their lowest edge, compact ones their foot.
extends SceneTree

const DIR := "res://assets/sprites/"
const OUT := "res://scripts/data/sprite_anchors.gd"
const SKIP_PREFIXES := ["decal_"]


func _init() -> void:
	var lines := PackedStringArray()
	var report := PackedStringArray()
	var dir := DirAccess.open(DIR)
	var names := []
	for file in dir.get_files():
		if file.ends_with(".png"):
			names.append(file.get_basename())
	names.sort()
	for name in names:
		var skip := false
		for prefix in SKIP_PREFIXES:
			if name.begins_with(prefix):
				skip = true
		if skip:
			continue
		var image := Image.load_from_file(ProjectSettings.globalize_path(DIR + name + ".png"))
		var result := _measure(image)
		lines.append('\t"%s": {"anchor": Vector2(%.3f, %.3f), "slope": %.2f},' % [name, result["cx"], result["ay"], result["slope"]])
		report.append("%-22s anchor (%.3f, %.3f)  slope %+.2f  %s" % [name, result["cx"], result["ay"], result["slope"], result["method"]])
	var out := FileAccess.open(OUT, FileAccess.WRITE)
	out.store_string("# Generated by scripts/dev/measure_sprite_anchors.gd. Do not edit by hand.\n")
	out.store_string("# anchor: ground point under the object as fractions of the image; slope: its\n")
	out.store_string("# ground edge on screen (positive like a backslash: a prop along the X axis).\n")
	out.store_string("extends RefCounted\n\nconst ANCHORS := {\n")
	out.store_string("\n".join(lines))
	out.store_string("\n}\n")
	out.close()
	print("\n".join(report))
	quit()


func _measure(image: Image) -> Dictionary:
	var w := image.get_width()
	var h := image.get_height()
	# Lowest opaque pixel of every second column.
	var columns := {}
	var min_x := w
	var max_x := 0
	var max_y := 0
	for x in range(0, w, 2):
		for y in range(h - 1, -1, -1):
			if image.get_pixel(x, y).a > 0.5:
				columns[x] = y
				min_x = min(min_x, x)
				max_x = max(max_x, x)
				max_y = max(max_y, y)
				break
	var bbox_w := max_x - min_x
	var cx := (min_x + max_x) / 2.0
	var aspect: float = float(bbox_w) / maxf(float(max_y), 1.0)
	if columns.size() < 8 or bbox_w < 40:
		return {"cx": cx / w, "ay": float(max_y) / h, "slope": 0.0, "method": "foot"}
	# Long props: fit a line to the lowest edge over the middle 70% of the width.
	var x_from := min_x + bbox_w * 0.15
	var x_to := max_x - bbox_w * 0.15
	var xs := []
	var ys := []
	for x in columns:
		if x >= x_from and x <= x_to:
			xs.append(float(x))
			ys.append(float(columns[x]))
	var n := xs.size()
	if n < 4:
		return {"cx": cx / w, "ay": float(max_y) / h, "slope": 0.0, "method": "foot"}
	var mean_x := 0.0
	var mean_y := 0.0
	for i in n:
		mean_x += xs[i]
		mean_y += ys[i]
	mean_x /= n
	mean_y /= n
	var num := 0.0
	var den := 0.0
	for i in n:
		num += (xs[i] - mean_x) * (ys[i] - mean_y)
		den += (xs[i] - mean_x) * (xs[i] - mean_x)
	var slope := num / den
	var edge_y := mean_y + slope * (cx - mean_x)
	if aspect < 1.2:
		# Tall or compact objects stand on a point, not along an edge.
		return {"cx": cx / w, "ay": float(max_y) / h, "slope": slope, "method": "foot"}
	return {"cx": cx / w, "ay": edge_y / h, "slope": slope, "method": "edge"}
