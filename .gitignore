# Godot 4+ regenerates this imported cache on each machine
.godot/

# Exported builds
/export.cfg
/export_presets.cfg
/build/

# Editor and OS files
.DS_Store
Thumbs.db

# Blender recovery copies and transient queued-job state
*.blend[1-9]
*.job.json
*.job.json.tmp

# Background task dispatch logs
/tasks/logs/

# Local review captures and logs (curated frames go to docs/pr-assets/)
/art/bridges/*/
/art/bridges/*.log
/art/bridges/materials.png

# Review captures of the sidewalk work and park (same policy as bridges)
/art/sidewalks/*/
/art/sidewalks/*.log
/art/sidewalks/*.png
/art/city_park/in-game-*.png
# Local railway review captures; curated PR JPEGs live in docs/pr-assets/.
art/railway/*.png
art/models/public_transport/er2/previews/
