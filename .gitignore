# Godot 4+ regenerates this imported cache on each machine
.godot/

# Exported builds
/export.cfg
/export_presets.cfg
/build/

# Editor and OS files
.DS_Store
Thumbs.db

# Blender recovery copies and transient queued-job state
*.blend[1-9]
*.job.json
*.job.json.tmp

# Background task dispatch logs
/tasks/logs/

# Local review captures and logs (PR images are uploaded as GitHub attachments)
/art/bridges/*/
/art/bridges/*.log
/art/bridges/materials.png

# Review captures of the sidewalk work and park (same policy as bridges)
/art/sidewalks/*/
/art/sidewalks/*.log
/art/sidewalks/*.png
/art/city_park/in-game-*.png
# Local railway review captures; selected frames become GitHub PR attachments.
art/railway/*.png
art/models/public_transport/er2/previews/

# Local PR media and generated optimizer reports. Existing tracked files remain tracked.
/.local/
/docs/pr-assets/
/art/optimization_reports/

# Bus visual review captures/logs stay local; sources and GLBs remain versionable.
/art/models/public_transport/shape_v1/*.png
/art/models/public_transport/shape_v1/*.log
/art/models/public_transport/shape_v1/comparison.blend
/art/models/public_transport/finish_v1/*.png
/art/models/public_transport/finish_v1/*.log
/art/models/public_transport/finish_v1/comparison.blend
